/*
 * Mumble Synthwave Theme
 *
 * Deep purple night with hot pink and cyan neon
 *
 * Uses the base theme of Mumble (see the Default theme) which is
 * licensed under The Do What The Fuck You Want To Public License (WTFPL).
 */
/*
 * YOU SHOULD NOT MODIFY THIS FILE
 * Edit the files in the "source" folder instead.
 * See project README
 *
 */
ApplicationPalette {
	qproperty-window: #1a1030;
	qproperty-windowtext: #efe6ff;
	qproperty-windowtext_disabled: #4a3a6b;
	qproperty-base: #120b24;
	qproperty-alternatebase: #1c1238;
	qproperty-text: #d9c9f5;
	qproperty-text_disabled: #4a3a6b;
	qproperty-tooltipbase: #120b24;
	qproperty-tooltiptext: #d9c9f5;
	qproperty-tooltiptext_disabled: #4a3a6b;
	qproperty-brighttext: #ffffff;
	qproperty-brighttext_disabled: #4a3a6b;
	qproperty-highlight: #ff2d95;
	qproperty-highlightedtext: #ffffff;
	qproperty-highlightedtext_disabled: #4a3a6b;
	qproperty-button: #2f2055;
	qproperty-buttontext: #d9c9f5;
	qproperty-buttontext_disabled: #4a3a6b;
	qproperty-link: #2de2e6;
	qproperty-linkvisited: #2de2e6;
	qproperty-light: #120b24;
	qproperty-midlight: transparent;
	qproperty-mid: #120b24;
	qproperty-dark: transparent;
	qproperty-shadow: #120b24;
}
QObject,
QObject::separator,
QObject::handle,
QObject::tab-bar,
QObject::tab,
QObject::section
{
	font-family: "Segoe UI", Frutiger, "Frutiger Linotype", "Dejavu Sans", "Helvetica Neue", "Microsoft YaHei UI", "PingFang SC", "Noto Sans SC", Arial, sans-serif;
	font-size: 10pt;
	margin:0;
	padding:0;
	outline:0;
	border:0;
	selection-background-color:#ff2d95;
	selection-color:#ffffff;
	alternate-background-color:transparent;
	color:#efe6ff;
	border-radius:4px;
}
QMainWindow,
QDockWidget
{
	background-color:#1a1030;
}
QDialog,
QWizard *,
QCalendarWidget *,
#qswPages > QObject
{
	background-color:#150e2c;
	color:#d9c9f5;
}
QObject:disabled,
QObject::item:disabled
{
	color:#4a3a6b;
}
a
{
	color:#2de2e6;
	text-decoration:none;
}
QObject::separator
{
	height:4px;
	width:4px;
}
QObject::separator:hover
{
	background:#251843;
}
DockTitleBar
{
	font-size: 7pt;
}
QToolTip,
QWhatsThis
{
	font-size:8pt;
	min-height:1.3em;
	border: 1px solid #9a85cf;
	border-radius: 0;
	background-color:#120b24;
	color:#d9c9f5;
}
QTextBrowser,
QTextEdit
{
	background-color:#120b24;
	color:#d9c9f5;
	border:1px solid #120b24;
}
QToolBar
{
	background-color:#1a1030;
	spacing:0;
	padding:2px;
}
QToolButton
{
	border:1px solid transparent;
	border-radius:4px;
	padding:1px;
	margin:1px;
}
QToolButton:on
{
	background-color:#2f2055;
	border:1px solid #3b2a63;
}
QToolButton:hover
{
	background-color:#3b2a63;
	border:1px solid #ff2d95;
}
QToolButton:pressed
{
	background-color:#2f2055;
}
QToolBar::separator
{
	background:#4a3a6b;
	height:1px;
	margin:4px;
	width:1px;
}
QToolBar::separator:hover
{
	background:#4a3a6b;
	border:0;
}
QToolButton#qt_toolbar_ext_button
{
	min-width:8px;
	width:8px;
	padding:1px;
	qproperty-icon:url(skin:controls/toolbar_ext.svg);
}
QToolBar::handle:horizontal
{
	image:url(skin:controls/handle_horizontal.svg);
	width:8px;
	padding:4px;
}
QToolBar::handle:vertical
{
	image:url(skin:controls/handle_vertical.svg);
	height:8px;
	padding:4px;
}
QMenuBar::item
{
	background-color:transparent;
	padding:4px 12px;
}
QMenuBar::item:selected
{
	background:#ff2d95;
	color:#ffffff;
}
QMenuBar::item:pressed
{
	background:#d81b7d;
	color:#ffffff;
}
QMenu
{
	background:#1e1437;
	border:1px solid #120b24;
	color:#d9c9f5;
}
QMenu::item
{
	border:1px solid transparent;
	color:#d9c9f5;
	padding:5px;
	padding-right:16px;
	padding-left:8px;
	border-radius:4px;
}
QMenu QLabel
{
	margin:0px;
	padding:5px;
	padding-right:8px;
	padding-left:25px;
}
QMenu QSlider
{
	padding-top:5px;
	padding-bottom:5px;
}
QMenu::icon
{
	left:4px;
}
QMenu::item:selected
{
	background:#3b2a63;
	border:1px solid #ff2d95;
}
QMenu::item:disabled
{
	border:1px solid transparent;
	background:transparent;
}
QMenu::separator
{
	background:#4a3a6b;
	height:1px;
}
QPushButton
{
	background-color:#2f2055;
	border:1px solid #3b2a63;
	color:#d9c9f5;
	font-size: 12pt;
	padding: 3px 20px;
}
QPushButton:focus
{
	background-color:#3b2a63;
}
QPushButton:hover
{
	background-color:#3b2a63;
	border-color:#52408a;
}
QPushButton:hover:focus
{
	background-color:#46326f;
	border-color:#ff2d95;
}
QPushButton:focus
{
	border-color:#2de2e6;
}
QPushButton:pressed,
QPushButton:pressed:focus
{
	background-color:#ff2d95;
	border-color:#ff2d95;
	color:#ffffff;
}
QGroupBox,
#qwMacWarning,
#qwInlineNotice
{
	background-color:#1c1238;
	border:1px solid #120b24;
	color:#d9c9f5;
	font-size: 13pt;
	padding:4px;
	padding-top:1em;
}
QGroupBox::title
{
	background-color:transparent;
	margin:6px;
	margin-left:8px;
	margin-right:8px;
}
QListView
{
	background-color:#120b24;
	border:1px solid #120b24;
}
QListView::item
{
	border-radius:4px;
	border:1px solid transparent;
	color:#d9c9f5;
	selection-color:#d9c9f5;
	padding:2px 4px;
}
QListView::item:hover
{
	background-color:#1c1238;
	border:1px solid #1c1238;
}
QListView::item:selected
{
	background-color:#2a1c4d;
	border:1px solid #3b2a63;
}
QListView::item:selected:active
{
	background-color:#3b2a63;
	border:1px solid #ff2d95;
}
QTreeView
{
	background-color:#120b24;
	color:#d9c9f5;
	selection-background-color:#120b24;
	selection-color:#d9c9f5;
	border:1px solid #120b24;
}
QTreeView::item
{
	min-width:60px;
	border:1px solid transparent;
	border-left:0;
	border-right:0;
	color:#d9c9f5;
	padding:2px 4px;
	selection-color:#d9c9f5;
	border-radius:0;
}
QTreeView::item:first,
QTreeView::item:only-one
{
	border-left:1px solid transparent;
	border-top-left-radius:4px;
	border-bottom-left-radius:4px;
}
QTreeView::item:last,
QTreeView::item:only-one
{
	border-right:1px solid transparent;
	border-top-right-radius:4px;
	border-bottom-right-radius:4px;
}
QTreeView::item:hover,
QTreeView::item:focus
{
	background-color:#1c1238;
	border-color:#1c1238;
}
QTreeView::item:selected
{
	background-color:#2a1c4d;
	border:1px solid #3b2a63;
	border-right:0;
	border-left:0;
}
QTreeView::item:selected:first,
QTreeView::item:selected:only-one
{
	border-left:1px solid #3b2a63;
}
QTreeView::item:selected:last,
QTreeView::item:selected:only-one
{
	border-right:1px solid #3b2a63;
}
QTreeView::item:selected:active
{
	background-color:#3b2a63;
	border:1px solid #ff2d95;
	border-right:0;
	border-left:0;
}
QTreeView::item:selected:active:first,
QTreeView::item:selected:active:only-one
{
	border-left:1px solid #ff2d95;
}
QTreeView::item:selected:active:last,
QTreeView::item:selected:active:only-one
{
	border-right:1px solid #ff2d95;
}
QTreeView::branch
{
	background-color:#120b24;
	border-image:none;
	image:none;
	padding-left:3px;
	padding-top:1px;
}
QTreeView::branch:has-children:closed
{
	image:url(skin:controls/branch_closed.svg);
}
QTreeView::branch:has-children:open
{
	image:url(skin:controls/branch_open.svg);
}
QHeaderView
{
	border-bottom:1px solid #120b24;
	border-radius:0;
}
QHeaderView::section
{
	border:0;
	background-color:#1c1238;
	color:#d9c9f5;
	padding:4px;
	padding-left:8px;
	padding-right: 20px;
	border-radius:0;
}
QHeaderView::down-arrow,
QHeaderView::up-arrow
{
	margin:1px;
	top:1px;
	right:5px;
	width:14px;
}
QHeaderView::down-arrow
{
	image:url(skin:controls/arrow_down.svg);
}
QHeaderView::up-arrow
{
	image:url(skin:controls/arrow_up.svg);
}
QTabWidget::pane
{
	background-color:#1c1238;
	border:1px solid #120b24;
}
QTabWidget::pane:top
{
	margin-top:-1px;
	border-radius:4px;
	border-top-left-radius:0;
}
QTabWidget::pane:bottom
{
	margin-bottom:-1px;
	border-radius:4px;
	border-bottom-left-radius:0;
}
QTabWidget::tab-bar
{
	background-color:#150e2c;
}
QTabBar::tab
{
	color:#cbbbe8;
	background-color:#170f2e;
	padding:6px 16px;
	border-radius:0;
	border:1px solid #120b24;
	border-right:0;
}
QTabBar::tab:last,
QTabBar::tab:only-one
{
	border-right:1px solid #120b24;
}
QTabBar::tab:hover
{
	background-color:#2f2055;
}
QTabBar::tab:disabled
{
	color:#4a3a6b;
}
QTabBar::tab:selected
{
	color:#d9c9f5;
	background-color:#1c1238;
}
QTabBar::tab:top
{
	border-bottom:0;
	margin-bottom:1px;
}
QTabBar::tab:bottom
{
	border-top:0;
	margin-top:1px;
}
QTabBar::tab:top:selected
{
	padding-bottom:7px;
	margin-bottom:0;
}
QTabBar::tab:bottom:selected
{
	padding-top:7px;
	margin-top:0;
}
QTabBar::tab:top:first,
QTabBar::tab:top:only-one
{
	border-top-left-radius:4px;
}
QTabBar::tab:top:last,
QTabBar::tab:top:only-one
{
	border-top-right-radius:4px;
}
QTabBar::tab:bottom:first,
QTabBar::tab:bottom:only-one
{
	border-bottom-left-radius:4px;
}
QTabBar::tab:bottom:last,
QTabBar::tab:bottom:only-one
{
	border-bottom-right-radius:4px;
}
QScrollBar
{
	border-radius:0;
	font-size: 10pt;
}
QScrollBar:vertical
{
	border-left:1px solid #120b24;
	width:1em;
}
QScrollBar:horizontal
{
	border-top:1px solid #120b24;
	height:1em;
}
QScrollBar::handle
{
	margin:-1px;
	background:#3b2a63;
	border:1px solid #120b24;
}
QScrollBar::handle:vertical
{
	min-height:10px;
}
QScrollBar::handle:horizontal
{
	min-width:10px;
}
QScrollBar::handle:hover
{
	background:#52408a;
}
QScrollBar::left-arrow,
QScrollBar::right-arrow,
QScrollBar::up-arrow,
QScrollBar::down-arrow,
QScrollBar::sub-line,
QScrollBar::add-line,
QScrollBar::add-page,
QScrollBar::sub-page
{
	background:#1a1030;
	height:0;
	width:0;
	border-radius:0;
	border:0;
}
QAbstractScrollArea::corner
{
	border-left:1px solid #120b24;
	border-top:1px solid #120b24;
	height:0;
	width:0;
	border-radius:0;
	border-top:1px solid #120b24;
	border-left:1px solid #120b24;
	background:#120b24;
}
QLineEdit,
QComboBox,
QSpinBox,
QAbstractSpinBox
{
	color:#d9c9f5;
	padding:4px;
	min-height:1em;
}
QComboBox,
QSpinBox,
QAbstractSpinBox
{
	border:1px solid #3b2a63;
	background-color:#2f2055;
}
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QAbstractSpinBox,
QComboBox:editable
{
	border:1px solid #3b2a63;
	background-color:#0f0a1f;
}
QSpinBox,
QAbstractSpinBox
{
	min-width: 2.5em;
	padding-right: 10px;
}
QPushButton:disabled,
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QListWidget:disabled,
QTreeWidget:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QAbstractSpinBox:disabled
{
	border:1px solid transparent;
	background-color:#251843;
}
QComboBox::drop-down,
QAbstractSpinBox::drop-down,
QSpinBox::drop-down,
QDateTimeEdit::drop-down
{
	background-color:#120b24;
	border:0;
	margin-left:4px;
	margin-right:12px;
	margin-top:5px;
}
QComboBox::down-arrow,
QDateTimeEdit::down-arrow
{
	margin-top: -2px;
	image:url(skin:controls/arrow_down.svg);
	width:14px;
}
QComboBox::down-arrow:disabled,
QDateTimeEdit::down-arrow:disabled
{
	image:url(skin:controls/arrow_down_disabled.svg);
}
QToolButton[popupMode="1"],
QToolButton[popupMode="2"],
QPushButton[popupMode="1"],
QPushButton[popupMode="2"]
{
	padding-right: 14px;
}
QToolButton::menu-arrow,
QToolButton::menu-indicator,
QPushButton::menu-arrow,
QPushButton::menu-indicator
{
	image:url(skin:controls/arrow_down.svg);
	subcontrol-origin: padding;
	subcontrol-position: center right;
	top:2px;
	right:2px;
	width:14px;
}
QSpinBox::down-button,
QAbstractSpinBox::down-button
{
	padding-right:4px;
	image:url(skin:controls/arrow_down.svg);
	width:14px;
	padding-bottom:1px;
}
QSpinBox::down-button:disabled,
QAbstractSpinBox::down-button:disabled
{
	image:url(skin:controls/arrow_down_disabled.svg);
}
QSpinBox::up-button,
QAbstractSpinBox::up-button
{
	padding-right:4px;
	image:url(skin:controls/arrow_up.svg);
	width:14px;
	padding-top:1px;
}
QSpinBox::up-button:disabled,
QAbstractSpinBox::up-button:disabled
{
	image:url(skin:controls/arrow_up_disabled.svg);
}
QComboBox QAbstractItemView
{
	background-color:#120b24;
	border:1px solid #120b24;
	color:#d9c9f5;
	border-radius:0;
}
QLabel,
QCheckBox,
QAbstractCheckBox,
QTreeView::indicator,
QRadioButton
{
	color:#d9c9f5;
	background:transparent;
}
QCheckBox::indicator,
QTreeView::indicator
{
	background-color:#2f2055;
	border:1px solid #3b2a63;
	height:13px;
	width:13px;
	margin-top: 1px;
}
QMenu::indicator
{
	padding-top:2px;
	width:12px;
	height:12px;
	left:6px;
	margin-right:8px;
}
QCheckBox::indicator:checked,
QMenu::indicator:checked,
QTreeView::indicator:checked
{
	image:url(skin:controls/checkbox_check_dark.svg);
}
QCheckBox::indicator:disabled,
QTreeView::indicator:disabled
{
	border:1px solid #1c1238;
	background-color:#251843;
}
QCheckBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled
{
	border:1px solid transparent;
	image:url(skin:controls/checkbox_check_disabled.svg);
}
QRadioButton::indicator
{
	background:#2f2055;
	border:1px solid #3b2a63;
	border-radius:7px;
	height:12px;
	width:12px;
}
QTreeView::indicator
{
	background:#2f2055;
}
QRadioButton::indicator:disabled
{
	background-color:#251843;
	margin:1px;
	border:1px solid transparent;
}
QRadioButton::indicator:checked
{
	image:url(skin:controls/radio_check_dark.svg);
}
QRadioButton::indicator:checked:disabled
{
	image:url(skin:controls/radio_check_disabled.svg);
}
QSlider::groove
{
	background:#1c1238;
	border:1px solid #3b2a63;
	border-radius:2px;
	font-size: 3pt;
}
QSlider::groove:horizontal
{
	height:0.8em;
}
QSlider::groove:vertical
{
	width:0.8em;
}
QSlider::groove:disabled,
QSlider::sub-page:disabled
{
	background:#251843;
	border:1px solid transparent;
	border-radius:2px;
}
QSlider::sub-page
{
	background: #2de2e6;
	border:1px solid #ff2d95;
	border-radius:2px;
}
QSlider::handle
{
	background:#d9c9f5;
	border:1px solid #0a0616;
	border-radius:3px;
	font-size: 4pt;
}
QSlider::handle:horizontal
{
	margin:-5px -1px;
	width:4.5em;
}
QSlider::handle:vertical
{
	margin:-1px -5px;
	height:4.5em;
}
QSlider::handle:focus
{
	background-color:#ff2d95;
	border-color:#2de2e6;
}
QSlider::handle:hover
{
	background-color:#e9dffb;
}
QSlider::handle:pressed
{
	background-color:#f4ecff;
	border-color:#0a0616;
}
QSlider::handle:disabled
{
	background-color:#251843;
	border:1px solid #251843;
}
QCheckBox::indicator:focus,
QTreeView::indicator:focus,
QRadioButton::indicator:focus,
QComboBox:focus
{
	background-color:#3b2a63;
}
QCheckBox::indicator:focus:hover,
QTreeView::indicator:focus:hover,
QRadioButton::indicator:focus:hover,
QComboBox:focus:hover
{
	background-color:#46326f;
	border-color:#ff2d95;
}
QCheckBox::indicator:hover,
QTreeView::indicator:hover,
QRadioButton::indicator:hover,
QComboBox:hover
{
	background-color:#3b2a63;
	border-color:#52408a;
}
QLineEdit:focus,
QSpinBox:focus,
QAbstractSpinBox:focus,
QComboBox:editable:focus
{
	background-color:#0f0a1f;
}
QLineEdit:focus:hover,
QSpinBox:focus:hover,
QAbstractSpinBox:focus:hover,
QComboBox:editable:focus:hover
{
	border-color:#ff2d95;
}
QLineEdit:hover,
QSpinBox:hover,
QAbstractSpinBox:hover,
QComboBox:editable:hover
{
	background-color:#0f0a1f;
	border-color:#52408a;
}
QCheckBox::indicator:focus,
QTreeView::indicator:focus,
QRadioButton::indicator:focus,
QComboBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QAbstractSpinBox:focus,
QComboBox:editable:focus
{
	border-color:#2de2e6;
}
QFontDialog
{
	min-width: 32em;
	min-height: 24em;
}
QColorDialog QColorLuminancePicker
{
	background-color:transparent;
}
QMessageBox,
QDialogButtonBox
{
	dialogbuttonbox-buttons-have-icons: 0;
}
/* Mumble Specifics */
LogTextBrowser,
#qdsChat
{
	margin:0 2px;
	min-height:120px;
	min-width:40px;
	border-color:#120b24;
}
UserView
{
	margin:0 2px;
	min-height:120px;
	min-width:40px;
}
UserView::item
{
	padding:0;
	padding-top:-1px;
}
#qdwChat > QTextEdit
{
	padding:-2px;
	margin:0 2px;
	margin-bottom:2px;
	font-size: 10pt;
}
#qtIconToolbar QComboBox
{
	font-size: 8pt;
}
.log-time
{
	background-color:transparent;
	color:#95a5a6;
	font-size: 9pt;
}
.log-server
{
	background-color:transparent;
	color:#F9655D;
	font-weight:bold;
}
.log-channel
{
	background-color:transparent;
	color:#e67e22;
	font-weight:bold;
}
.log-privilege
{
	background-color:transparent;
	color:#c0392b;
	font-weight:bold;
}
.log-target
{
	background-color:transparent;
	color:#27ae60;
	font-weight:bold;
}
.log-source
{
	background-color:transparent;
	color:#27ae60;
	font-weight:bold;
}
QListView#qlwIcons
{
	padding:0;
	background-color:transparent;
	border:0;
	font-size: 12pt;
	min-width:165%;
	margin-left:4px;
	margin-top:12px;
}
QListView#qlwIcons::item
{
	margin-bottom:1px;
	padding:5px 7px;
}
QListView#qlwIcons::item:hover
{
	border-color:#251843;
	background-color:#251843;
}
QListView#qlwIcons::item:selected
{
	background-color:#2f2055;
	border:1px solid #3b2a63;
}
QListView#qlwIcons::item:focus
{
	background-color:#3b2a63;
	border:1px solid #ff2d95;
}
QSlider
{
	margin-left:30px;
	margin-right:30px;
}
#qswPages > * > * > QScrollBar
{
	margin:0;
}
#qswPages > * > QWidget
{
	margin: 2px;	
}
QListView::item QListWidgetItem,
QListView::item QLineEdit,
QTreeView::item QComboBox,
QTreeView::item QLineEdit
{
	background:#2f2055;
	margin: 0;
	padding-top: 0;
	padding-bottom: 0;
	padding-left: 4px;
	padding-right: 4px;
	font-size: 9pt;
}
QListView::item QListWidgetItem:hover,
QListView::item QLineEdit:hover,
QTreeView::item QComboBox:hover,
QTreeView::item QLineEdit:hover
{
	background:#2f2055;
}
AboutDialog > QTextBrowser,
AboutDialog QTextEdit
{
	border:0;
}
#qtbToolBar
{
        border:1px solid transparent;
	background:transparent;
}
#BanEditor
{
	min-width: 600px;
}
#GlobalShortcutTarget
{
	min-height: 600px;
}
ViewCert
{
	min-height: 600px;
}
TalkingUI
{
	background-color: #120b24;
}
TalkingUI > *
{
	background-color: #120b24;
}
TalkingUI [selected="false"]
{
	background-color: #120b24;
}
TalkingUI [selected="false"]:hover {
	background-color: #1c1238;
}
TalkingUI [selected="true"] {
	background-color: #3b2a63;
  	border: 1px solid #ff2d95;
}
TalkingUI > QFrame {
	border: 1px solid;
	border-color: #120b24;
	border-radius: 4px;
}
