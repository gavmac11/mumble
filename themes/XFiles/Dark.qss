/*
 * Mumble X-Files Theme
 *
 * Conspiracy green with amber accents and a typewriter feel
 *
 * Uses the base theme of Mumble (see the Default theme) which is
 * licensed under The Do What The Fuck You Want To Public License (WTFPL).
 */
/*
 * YOU SHOULD NOT MODIFY THIS FILE
 * Edit the files in the "source" folder instead.
 * See project README
 *
 */
ApplicationPalette {
	qproperty-window: #0c120e;
	qproperty-windowtext: #d3e4d6;
	qproperty-windowtext_disabled: #3a4a40;
	qproperty-base: #080d0a;
	qproperty-alternatebase: #0d1510;
	qproperty-text: #bcd1c1;
	qproperty-text_disabled: #3a4a40;
	qproperty-tooltipbase: #080d0a;
	qproperty-tooltiptext: #bcd1c1;
	qproperty-tooltiptext_disabled: #3a4a40;
	qproperty-brighttext: #eaf5ec;
	qproperty-brighttext_disabled: #3a4a40;
	qproperty-highlight: #2e5c3f;
	qproperty-highlightedtext: #eaf5ec;
	qproperty-highlightedtext_disabled: #3a4a40;
	qproperty-button: #1a2921;
	qproperty-buttontext: #bcd1c1;
	qproperty-buttontext_disabled: #3a4a40;
	qproperty-link: #8fd19e;
	qproperty-linkvisited: #8fd19e;
	qproperty-light: #1f3327;
	qproperty-midlight: transparent;
	qproperty-mid: #1f3327;
	qproperty-dark: transparent;
	qproperty-shadow: #1f3327;
}
QObject,
QObject::separator,
QObject::handle,
QObject::tab-bar,
QObject::tab,
QObject::section
{
	font-family: "Courier New", "DejaVu Sans Mono", "Liberation Mono", "Consolas", monospace;
	font-size: 10pt;
	margin:0;
	padding:0;
	outline:0;
	border:0;
	selection-background-color:#2e5c3f;
	selection-color:#eaf5ec;
	alternate-background-color:transparent;
	color:#d3e4d6;
	border-radius:2px;
}
QMainWindow,
QDockWidget
{
	background-color:#0c120e;
}
QDialog,
QWizard *,
QCalendarWidget *,
#qswPages > QObject
{
	background-color:#0a100c;
	color:#bcd1c1;
}
QObject:disabled,
QObject::item:disabled
{
	color:#3a4a40;
}
a
{
	color:#8fd19e;
	text-decoration:none;
}
QObject::separator
{
	height:4px;
	width:4px;
}
QObject::separator:hover
{
	background:#14201a;
}
DockTitleBar
{
	font-size: 7pt;
}
QToolTip,
QWhatsThis
{
	font-size:8pt;
	min-height:1.3em;
	border: 1px solid #6d8a76;
	border-radius: 0;
	background-color:#080d0a;
	color:#bcd1c1;
}
QTextBrowser,
QTextEdit
{
	background-color:#080d0a;
	color:#bcd1c1;
	border:1px solid #1f3327;
}
QToolBar
{
	background-color:#0c120e;
	spacing:0;
	padding:2px;
}
QToolButton
{
	border:1px solid transparent;
	border-radius:2px;
	padding:1px;
	margin:1px;
}
QToolButton:on
{
	background-color:#1a2921;
	border:1px solid #24382c;
}
QToolButton:hover
{
	background-color:#213a2c;
	border:1px solid #2e5c3f;
}
QToolButton:pressed
{
	background-color:#1c2c23;
}
QToolBar::separator
{
	background:#2a4232;
	height:1px;
	margin:4px;
	width:1px;
}
QToolBar::separator:hover
{
	background:#2a4232;
	border:0;
}
QToolButton#qt_toolbar_ext_button
{
	min-width:8px;
	width:8px;
	padding:1px;
	qproperty-icon:url(skin:controls/toolbar_ext.svg);
}
QToolBar::handle:horizontal
{
	image:url(skin:controls/handle_horizontal.svg);
	width:8px;
	padding:4px;
}
QToolBar::handle:vertical
{
	image:url(skin:controls/handle_vertical.svg);
	height:8px;
	padding:4px;
}
QMenuBar::item
{
	background-color:transparent;
	padding:4px 12px;
}
QMenuBar::item:selected
{
	background:#2e5c3f;
	color:#eaf5ec;
}
QMenuBar::item:pressed
{
	background:#234934;
	color:#eaf5ec;
}
QMenu
{
	background:#101913;
	border:1px solid #1f3327;
	color:#bcd1c1;
}
QMenu::item
{
	border:1px solid transparent;
	color:#bcd1c1;
	padding:5px;
	padding-right:16px;
	padding-left:8px;
	border-radius:2px;
}
QMenu QLabel
{
	margin:0px;
	padding:5px;
	padding-right:8px;
	padding-left:25px;
}
QMenu QSlider
{
	padding-top:5px;
	padding-bottom:5px;
}
QMenu::icon
{
	left:4px;
}
QMenu::item:selected
{
	background:#1d3a2a;
	border:1px solid #2e5c3f;
}
QMenu::item:disabled
{
	border:1px solid transparent;
	background:transparent;
}
QMenu::separator
{
	background:#2a4232;
	height:1px;
}
QPushButton
{
	background-color:#1a2921;
	border:1px solid #24382c;
	color:#bcd1c1;
	font-size: 12pt;
	padding: 3px 20px;
}
QPushButton:focus
{
	background-color:#1d3a2a;
}
QPushButton:hover
{
	background-color:#233529;
	border-color:#314939;
}
QPushButton:hover:focus
{
	background-color:#245033;
	border-color:#2e5c3f;
}
QPushButton:focus
{
	border-color:#d9a441;
}
QPushButton:pressed,
QPushButton:pressed:focus
{
	background-color:#2e5c3f;
	border-color:#2e5c3f;
	color:#eaf5ec;
}
QGroupBox,
#qwMacWarning,
#qwInlineNotice
{
	background-color:#0d1510;
	border:1px solid #1f3327;
	color:#bcd1c1;
	font-size: 13pt;
	padding:4px;
	padding-top:1em;
}
QGroupBox::title
{
	background-color:transparent;
	margin:6px;
	margin-left:8px;
	margin-right:8px;
}
QListView
{
	background-color:#080d0a;
	border:1px solid #1f3327;
}
QListView::item
{
	border-radius:2px;
	border:1px solid transparent;
	color:#bcd1c1;
	selection-color:#bcd1c1;
	padding:2px 4px;
}
QListView::item:hover
{
	background-color:#101a14;
	border:1px solid #101a14;
}
QListView::item:selected
{
	background-color:#17241d;
	border:1px solid #1f3327;
}
QListView::item:selected:active
{
	background-color:#1d3a2a;
	border:1px solid #2e5c3f;
}
QTreeView
{
	background-color:#080d0a;
	color:#bcd1c1;
	selection-background-color:#080d0a;
	selection-color:#bcd1c1;
	border:1px solid #1f3327;
}
QTreeView::item
{
	min-width:60px;
	border:1px solid transparent;
	border-left:0;
	border-right:0;
	color:#bcd1c1;
	padding:2px 4px;
	selection-color:#bcd1c1;
	border-radius:0;
}
QTreeView::item:first,
QTreeView::item:only-one
{
	border-left:1px solid transparent;
	border-top-left-radius:2px;
	border-bottom-left-radius:2px;
}
QTreeView::item:last,
QTreeView::item:only-one
{
	border-right:1px solid transparent;
	border-top-right-radius:2px;
	border-bottom-right-radius:2px;
}
QTreeView::item:hover,
QTreeView::item:focus
{
	background-color:#101a14;
	border-color:#101a14;
}
QTreeView::item:selected
{
	background-color:#17241d;
	border:1px solid #1f3327;
	border-right:0;
	border-left:0;
}
QTreeView::item:selected:first,
QTreeView::item:selected:only-one
{
	border-left:1px solid #1f3327;
}
QTreeView::item:selected:last,
QTreeView::item:selected:only-one
{
	border-right:1px solid #1f3327;
}
QTreeView::item:selected:active
{
	background-color:#1d3a2a;
	border:1px solid #2e5c3f;
	border-right:0;
	border-left:0;
}
QTreeView::item:selected:active:first,
QTreeView::item:selected:active:only-one
{
	border-left:1px solid #2e5c3f;
}
QTreeView::item:selected:active:last,
QTreeView::item:selected:active:only-one
{
	border-right:1px solid #2e5c3f;
}
QTreeView::branch
{
	background-color:#080d0a;
	border-image:none;
	image:none;
	padding-left:3px;
	padding-top:1px;
}
QTreeView::branch:has-children:closed
{
	image:url(skin:controls/branch_closed.svg);
}
QTreeView::branch:has-children:open
{
	image:url(skin:controls/branch_open.svg);
}
QHeaderView
{
	border-bottom:1px solid #1f3327;
	border-radius:0;
}
QHeaderView::section
{
	border:0;
	background-color:#0d1510;
	color:#bcd1c1;
	padding:4px;
	padding-left:8px;
	padding-right: 20px;
	border-radius:0;
}
QHeaderView::down-arrow,
QHeaderView::up-arrow
{
	margin:1px;
	top:1px;
	right:5px;
	width:14px;
}
QHeaderView::down-arrow
{
	image:url(skin:controls/arrow_down.svg);
}
QHeaderView::up-arrow
{
	image:url(skin:controls/arrow_up.svg);
}
QTabWidget::pane
{
	background-color:#0d1510;
	border:1px solid #1f3327;
}
QTabWidget::pane:top
{
	margin-top:-1px;
	border-radius:2px;
	border-top-left-radius:0;
}
QTabWidget::pane:bottom
{
	margin-bottom:-1px;
	border-radius:2px;
	border-bottom-left-radius:0;
}
QTabWidget::tab-bar
{
	background-color:#0a100c;
}
QTabBar::tab
{
	color:#b7ccbc;
	background-color:#0b120e;
	padding:6px 16px;
	border-radius:0;
	border:1px solid #1f3327;
	border-right:0;
}
QTabBar::tab:last,
QTabBar::tab:only-one
{
	border-right:1px solid #1f3327;
}
QTabBar::tab:hover
{
	background-color:#1a2a21;
}
QTabBar::tab:disabled
{
	color:#3a4a40;
}
QTabBar::tab:selected
{
	color:#bcd1c1;
	background-color:#0d1510;
}
QTabBar::tab:top
{
	border-bottom:0;
	margin-bottom:1px;
}
QTabBar::tab:bottom
{
	border-top:0;
	margin-top:1px;
}
QTabBar::tab:top:selected
{
	padding-bottom:7px;
	margin-bottom:0;
}
QTabBar::tab:bottom:selected
{
	padding-top:7px;
	margin-top:0;
}
QTabBar::tab:top:first,
QTabBar::tab:top:only-one
{
	border-top-left-radius:2px;
}
QTabBar::tab:top:last,
QTabBar::tab:top:only-one
{
	border-top-right-radius:2px;
}
QTabBar::tab:bottom:first,
QTabBar::tab:bottom:only-one
{
	border-bottom-left-radius:2px;
}
QTabBar::tab:bottom:last,
QTabBar::tab:bottom:only-one
{
	border-bottom-right-radius:2px;
}
QScrollBar
{
	border-radius:0;
	font-size: 10pt;
}
QScrollBar:vertical
{
	border-left:1px solid #1f3327;
	width:1em;
}
QScrollBar:horizontal
{
	border-top:1px solid #1f3327;
	height:1em;
}
QScrollBar::handle
{
	margin:-1px;
	background:#263829;
	border:1px solid #1f3327;
}
QScrollBar::handle:vertical
{
	min-height:10px;
}
QScrollBar::handle:horizontal
{
	min-width:10px;
}
QScrollBar::handle:hover
{
	background:#3a5241;
}
QScrollBar::left-arrow,
QScrollBar::right-arrow,
QScrollBar::up-arrow,
QScrollBar::down-arrow,
QScrollBar::sub-line,
QScrollBar::add-line,
QScrollBar::add-page,
QScrollBar::sub-page
{
	background:#0c120e;
	height:0;
	width:0;
	border-radius:0;
	border:0;
}
QAbstractScrollArea::corner
{
	border-left:1px solid #1f3327;
	border-top:1px solid #1f3327;
	height:0;
	width:0;
	border-radius:0;
	border-top:1px solid #1f3327;
	border-left:1px solid #1f3327;
	background:#080d0a;
}
QLineEdit,
QComboBox,
QSpinBox,
QAbstractSpinBox
{
	color:#bcd1c1;
	padding:4px;
	min-height:1em;
}
QComboBox,
QSpinBox,
QAbstractSpinBox
{
	border:1px solid #24382c;
	background-color:#1a2921;
}
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QAbstractSpinBox,
QComboBox:editable
{
	border:1px solid #1f3327;
	background-color:#080d0a;
}
QSpinBox,
QAbstractSpinBox
{
	min-width: 2.5em;
	padding-right: 10px;
}
QPushButton:disabled,
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QListWidget:disabled,
QTreeWidget:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QAbstractSpinBox:disabled
{
	border:1px solid transparent;
	background-color:#101a14;
}
QComboBox::drop-down,
QAbstractSpinBox::drop-down,
QSpinBox::drop-down,
QDateTimeEdit::drop-down
{
	background-color:#080d0a;
	border:0;
	margin-left:4px;
	margin-right:12px;
	margin-top:5px;
}
QComboBox::down-arrow,
QDateTimeEdit::down-arrow
{
	margin-top: -2px;
	image:url(skin:controls/arrow_down.svg);
	width:14px;
}
QComboBox::down-arrow:disabled,
QDateTimeEdit::down-arrow:disabled
{
	image:url(skin:controls/arrow_down_disabled.svg);
}
QToolButton[popupMode="1"],
QToolButton[popupMode="2"],
QPushButton[popupMode="1"],
QPushButton[popupMode="2"]
{
	padding-right: 14px;
}
QToolButton::menu-arrow,
QToolButton::menu-indicator,
QPushButton::menu-arrow,
QPushButton::menu-indicator
{
	image:url(skin:controls/arrow_down.svg);
	subcontrol-origin: padding;
	subcontrol-position: center right;
	top:2px;
	right:2px;
	width:14px;
}
QSpinBox::down-button,
QAbstractSpinBox::down-button
{
	padding-right:4px;
	image:url(skin:controls/arrow_down.svg);
	width:14px;
	padding-bottom:1px;
}
QSpinBox::down-button:disabled,
QAbstractSpinBox::down-button:disabled
{
	image:url(skin:controls/arrow_down_disabled.svg);
}
QSpinBox::up-button,
QAbstractSpinBox::up-button
{
	padding-right:4px;
	image:url(skin:controls/arrow_up.svg);
	width:14px;
	padding-top:1px;
}
QSpinBox::up-button:disabled,
QAbstractSpinBox::up-button:disabled
{
	image:url(skin:controls/arrow_up_disabled.svg);
}
QComboBox QAbstractItemView
{
	background-color:#080d0a;
	border:1px solid #1f3327;
	color:#bcd1c1;
	border-radius:0;
}
QLabel,
QCheckBox,
QAbstractCheckBox,
QTreeView::indicator,
QRadioButton
{
	color:#bcd1c1;
	background:transparent;
}
QCheckBox::indicator,
QTreeView::indicator
{
	background-color:#1a2921;
	border:1px solid #24382c;
	height:13px;
	width:13px;
	margin-top: 1px;
}
QMenu::indicator
{
	padding-top:2px;
	width:12px;
	height:12px;
	left:6px;
	margin-right:8px;
}
QCheckBox::indicator:checked,
QMenu::indicator:checked,
QTreeView::indicator:checked
{
	image:url(skin:controls/checkbox_check_dark.svg);
}
QCheckBox::indicator:disabled,
QTreeView::indicator:disabled
{
	border:1px solid #0d1510;
	background-color:#101a14;
}
QCheckBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled
{
	border:1px solid transparent;
	image:url(skin:controls/checkbox_check_disabled.svg);
}
QRadioButton::indicator
{
	background:#1a2921;
	border:1px solid #24382c;
	border-radius:7px;
	height:12px;
	width:12px;
}
QTreeView::indicator
{
	background:#1a2921;
}
QRadioButton::indicator:disabled
{
	background-color:#101a14;
	margin:1px;
	border:1px solid transparent;
}
QRadioButton::indicator:checked
{
	image:url(skin:controls/radio_check_dark.svg);
}
QRadioButton::indicator:checked:disabled
{
	image:url(skin:controls/radio_check_disabled.svg);
}
QSlider::groove
{
	background:#0f1a13;
	border:1px solid #1f3327;
	border-radius:2px;
	font-size: 3pt;
}
QSlider::groove:horizontal
{
	height:0.8em;
}
QSlider::groove:vertical
{
	width:0.8em;
}
QSlider::groove:disabled,
QSlider::sub-page:disabled
{
	background:#101a14;
	border:1px solid transparent;
	border-radius:2px;
}
QSlider::sub-page
{
	background: #3f7351;
	border:1px solid #6fae83;
	border-radius:2px;
}
QSlider::handle
{
	background:#8fa894;
	border:1px solid #05130b;
	border-radius:3px;
	font-size: 4pt;
}
QSlider::handle:horizontal
{
	margin:-5px -1px;
	width:4.5em;
}
QSlider::handle:vertical
{
	margin:-1px -5px;
	height:4.5em;
}
QSlider::handle:focus
{
	background-color:#6fae83;
	border-color:#d9a441;
}
QSlider::handle:hover
{
	background-color:#a9c2ad;
}
QSlider::handle:pressed
{
	background-color:#d9e6db;
	border-color:#05130b;
}
QSlider::handle:disabled
{
	background-color:#101a14;
	border:1px solid #101a14;
}
QCheckBox::indicator:focus,
QTreeView::indicator:focus,
QRadioButton::indicator:focus,
QComboBox:focus
{
	background-color:#1d3a2a;
}
QCheckBox::indicator:focus:hover,
QTreeView::indicator:focus:hover,
QRadioButton::indicator:focus:hover,
QComboBox:focus:hover
{
	background-color:#245033;
	border-color:#2e5c3f;
}
QCheckBox::indicator:hover,
QTreeView::indicator:hover,
QRadioButton::indicator:hover,
QComboBox:hover
{
	background-color:#233529;
	border-color:#314939;
}
QLineEdit:focus,
QSpinBox:focus,
QAbstractSpinBox:focus,
QComboBox:editable:focus
{
	background-color:#080d0a;
}
QLineEdit:focus:hover,
QSpinBox:focus:hover,
QAbstractSpinBox:focus:hover,
QComboBox:editable:focus:hover
{
	border-color:#2e5c3f;
}
QLineEdit:hover,
QSpinBox:hover,
QAbstractSpinBox:hover,
QComboBox:editable:hover
{
	background-color:#080d0a;
	border-color:#314939;
}
QCheckBox::indicator:focus,
QTreeView::indicator:focus,
QRadioButton::indicator:focus,
QComboBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QAbstractSpinBox:focus,
QComboBox:editable:focus
{
	border-color:#d9a441;
}
QFontDialog
{
	min-width: 32em;
	min-height: 24em;
}
QColorDialog QColorLuminancePicker
{
	background-color:transparent;
}
QMessageBox,
QDialogButtonBox
{
	dialogbuttonbox-buttons-have-icons: 0;
}
/* Mumble Specifics */
LogTextBrowser,
#qdsChat
{
	margin:0 2px;
	min-height:120px;
	min-width:40px;
	border-color:#1f3327;
}
UserView
{
	margin:0 2px;
	min-height:120px;
	min-width:40px;
}
UserView::item
{
	padding:0;
	padding-top:-1px;
}
#qdwChat > QTextEdit
{
	padding:-2px;
	margin:0 2px;
	margin-bottom:2px;
	font-size: 10pt;
}
#qtIconToolbar QComboBox
{
	font-size: 8pt;
}
.log-time
{
	background-color:transparent;
	color:#95a5a6;
	font-size: 9pt;
}
.log-server
{
	background-color:transparent;
	color:#F9655D;
	font-weight:bold;
}
.log-channel
{
	background-color:transparent;
	color:#e67e22;
	font-weight:bold;
}
.log-privilege
{
	background-color:transparent;
	color:#c0392b;
	font-weight:bold;
}
.log-target
{
	background-color:transparent;
	color:#27ae60;
	font-weight:bold;
}
.log-source
{
	background-color:transparent;
	color:#27ae60;
	font-weight:bold;
}
QListView#qlwIcons
{
	padding:0;
	background-color:transparent;
	border:0;
	font-size: 12pt;
	min-width:165%;
	margin-left:4px;
	margin-top:12px;
}
QListView#qlwIcons::item
{
	margin-bottom:1px;
	padding:5px 7px;
}
QListView#qlwIcons::item:hover
{
	border-color:#14201a;
	background-color:#14201a;
}
QListView#qlwIcons::item:selected
{
	background-color:#1a2921;
	border:1px solid #24382c;
}
QListView#qlwIcons::item:focus
{
	background-color:#1d3a2a;
	border:1px solid #2e5c3f;
}
QSlider
{
	margin-left:30px;
	margin-right:30px;
}
#qswPages > * > * > QScrollBar
{
	margin:0;
}
#qswPages > * > QWidget
{
	margin: 2px;	
}
QListView::item QListWidgetItem,
QListView::item QLineEdit,
QTreeView::item QComboBox,
QTreeView::item QLineEdit
{
	background:#1a2921;
	margin: 0;
	padding-top: 0;
	padding-bottom: 0;
	padding-left: 4px;
	padding-right: 4px;
	font-size: 9pt;
}
QListView::item QListWidgetItem:hover,
QListView::item QLineEdit:hover,
QTreeView::item QComboBox:hover,
QTreeView::item QLineEdit:hover
{
	background:#1a2921;
}
AboutDialog > QTextBrowser,
AboutDialog QTextEdit
{
	border:0;
}
#qtbToolBar
{
        border:1px solid transparent;
	background:transparent;
}
#BanEditor
{
	min-width: 600px;
}
#GlobalShortcutTarget
{
	min-height: 600px;
}
ViewCert
{
	min-height: 600px;
}
TalkingUI
{
	background-color: #080d0a;
}
TalkingUI > *
{
	background-color: #080d0a;
}
TalkingUI [selected="false"]
{
	background-color: #080d0a;
}
TalkingUI [selected="false"]:hover {
	background-color: #101a14;
}
TalkingUI [selected="true"] {
	background-color: #1d3a2a;
  	border: 1px solid #2e5c3f;
}
TalkingUI > QFrame {
	border: 1px solid;
	border-color: #1f3327;
	border-radius: 2px;
}
